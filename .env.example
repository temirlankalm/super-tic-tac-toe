# ==============================================================================
# Tic³ (Ultimate Tic-Tac-Toe) - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Analytics Authentication
# ------------------------------------------------------------------------------
# (Optional) Restrict login to a specific email address. If unset, any email or empty email is accepted with the password.
ADMIN_EMAIL=admin@example.com

# Admin password for access to /admin and protected /api/admin/* endpoints.
# Default in development if unset is: temr
ADMIN_PASSWORD=your_secure_admin_password_here

# (Optional) SHA-256 hash (in hex) of your password. If set, this takes precedence over ADMIN_PASSWORD.
# Generate with: echo -n "your_password" | shasum -a 256
# ADMIN_PASSWORD_HASH=6c33c...

# Secret used to sign secure httpOnly session cookies and salt daily IP hashes.
# Set this to a long random string in production (e.g. openssl rand -hex 32)
ADMIN_SESSION_SECRET=change_me_to_a_random_32_byte_string_for_production

# ------------------------------------------------------------------------------
# 2. Analytics Persistence
# ------------------------------------------------------------------------------
# Custom path for analytics storage (defaults to .data/analytics.json, or /tmp in serverless)
# ANALYTICS_DATA_PATH=/path/to/analytics.json
